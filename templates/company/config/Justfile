# The recipes that check.yaml's `company-validate` job runs when the caller
# switches them on (`tenant-validate: true`, `chart-gate: true`). Both are
# STUBS that fail on purpose: a stub that passed would read as a gate that
# ran. Replace each body when the validator it names is released, and only
# then switch the input on.

default:
    @just --list

# Validate this candidate against the published tenant inputs.
# TENANT_INPUTS_DIR is the verified artifact, outside the checkout; nothing
# committed here stands in for it.
tenant-validate:
    #!/usr/bin/env bash
    set -euo pipefail
    : "${TENANT_INPUTS_DIR:?not set: tenant-validate runs in check.yaml's company-validate job}"
    echo "tenant-validate: the tenant validator is not released yet; this recipe is a stub" >&2
    exit 1

# Render this candidate's charts and gate them, reading private charts with
# the credential the job logged in with (DOCKER_CONFIG, HELM_REGISTRY_CONFIG).
chart-gate:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "chart-gate: the chart gate does not take explicit inputs yet; this recipe is a stub" >&2
    exit 1
