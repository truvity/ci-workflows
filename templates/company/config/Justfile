# The recipe that check.yaml's `company-validate` job runs when the caller
# switches it on (`chart-gate: true`). It is a STUB that fails on purpose: a
# stub that passed would read as a gate that ran. Replace its body when the
# chart gate that takes explicit inputs is released, and only then switch
# the input on.
#
# There is no `tenant-validate` recipe: the shared workflow validates the
# `tenant/` bundle itself, with truvity/policy's validator at a version it
# pins, so a company's copy has nothing to keep in step with it.

default:
    @just --list

# Render this candidate's charts and gate them, reading private charts with
# the credential the job logged in with (DOCKER_CONFIG, HELM_REGISTRY_CONFIG).
chart-gate:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "chart-gate: the chart gate does not take explicit inputs yet; this recipe is a stub" >&2
    exit 1
